PORT=8080
SUPABASE_AUTHORIZE_ENDPOINT=/auth/v1/authorize?
SUPABASE_TOKEN_ENDPOINT=/auth/v1/token?grant_type=pkce
SUPABASE_REFRESH_TOKEN_ENDPOINT=/auth/v1/token?grant_type=refresh_token
DATABASE_API=/rest/v1/
RATE_LIMIT=10
REFRESH_TOKEN_DURATION_HOURS=672

# DO NOT commit the real values for the bellow configs
# For local development, set them in a separate .env.local file
APP_CALL_BACK_URL=<domain>/auth/google/callback
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SESSION_SECRET=<random long string>